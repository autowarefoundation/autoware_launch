<launch>
  <arg name="agnocast_heaphook_path" default="/opt/ros/humble/lib/libagnocast_heaphook.so" description="Path to the agnocast heaphook library"/>

  <arg name="launch_driver" default="true"/>
  <arg name="setup_sensor" default="true"/>
  <arg name="host_ip" default="192.168.1.11"/>
  <!-- <arg name="host_ip" default="224.0.3.3"/> -->
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="use_pointcloud_container" default="false" description="launch pointcloud container"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="pipeline_mode" default="cuda">
    <choice value="cuda"/>
    <choice value="cpu"/>
    <choice value="cuda-all-in-one"/>
    <choice value="cuda-with-cpu-concat"/>
  </arg>
  <arg name="udp_only" default="false"/>
  <arg name="dual_return_filter_param_file" default="$(find-pkg-share aip_x2_gen2_launch)/config/dual_return_filter.param.yaml"/>
  <arg name="blockage_diagnostics_param_file" default="$(find-pkg-share aip_x2_gen2_launch)/config/blockage_diagnostics.param.yaml"/>
  <arg name="ring_outlier_filter_node_param_file" default="$(find-pkg-share aip_x2_gen2_launch)/config/ring_outlier_filter_node.param.yaml"/>
  <arg name="distortion_corrector_node_param_file" default="$(find-pkg-share aip_x2_gen2_launch)/config/distortion_corrector_node.param.yaml"/>
  <arg name="enable_blockage_diag" default="true"/>
  <arg name="enable_calibration_download" default="false"/>

  <arg name="polar_voxel_visibility_estimation_mode" default="cpu">
    <choice value="cpu"/>
    <choice value="cuda"/>
    <choice value="disable"/>
  </arg>
  <arg name="polar_voxel_outlier_filter_node_param_file" default="$(find-pkg-share aip_x2_gen2_launch)/config/polar_voxel_outlier_filter_node.param.yaml"/>

  <let name="use_cuda_concat" value="$(eval '\'$(var pipeline_mode)\' == \'cuda\' or \'$(var pipeline_mode)\' == \'cuda-all-in-one\'')"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <include file="$(find-pkg-share aip_x2_gen2_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="use_cuda" value="$(var use_cuda_concat)"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    </include>

    <!-- LiDARs connected to Main ECU -->
