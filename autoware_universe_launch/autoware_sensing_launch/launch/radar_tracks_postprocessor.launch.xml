<launch>
  <!-- topics -->
  <arg name="input/tracks" default="objects_raw"/>
  <arg name="input/odometry" default="/localization/kinematic_state"/>
  <arg name="output/noise_tracks" default="noise_objects"/>
  <arg name="output/filtered_tracks" default="filtered_objects"/>
  <arg name="output/radar_detected_objects" default="detected_objects"/>
  <arg name="output/radar_tracked_objects" default="tracked_objects"/>
  <!-- parameter path -->
  <arg name="radar_tracks_msgs_converter_param_path" default="$(find-pkg-share autoware_sensing_launch)/config/radar_tracks_msgs_converter.param.yaml"/>
  <arg name="radar_tracks_noise_filter_param_path" default="$(find-pkg-share autoware_sensing_launch)/config/radar_tracks_noise_filter.param.yaml"/>

  <!-- Noise filter -->
  <include file="$(find-pkg-share autoware_radar_tracks_noise_filter)/launch/radar_tracks_noise_filter.launch.xml">
    <arg name="input/tracks" value="$(var input/tracks)"/>
    <arg name="output/noise_tracks" value="$(var output/noise_tracks)"/>
    <arg name="output/filtered_tracks" value="$(var output/filtered_tracks)"/>
    <arg name="param_path" value="$(var radar_tracks_noise_filter_param_path)"/>
  </include>

  <!-- Message converter -->
  <include file="$(find-pkg-share autoware_radar_tracks_msgs_converter)/launch/radar_tracks_msgs_converter.launch.xml">
    <arg name="input/radar_objects" value="$(var output/filtered_tracks)"/>
    <arg name="input/odometry" value="$(var input/odometry)"/>
    <arg name="output/radar_detected_objects" value="$(var output/radar_detected_objects)"/>
    <arg name="output/radar_tracked_objects" value="$(var output/radar_tracked_objects)"/>
    <arg name="param_path" value="$(var radar_tracks_msgs_converter_param_path)"/>
  </include>
</launch>
