<launch>
  <!-- Vehicle body crop box followed by a secondary crop box, loaded into an existing container -->
  <arg name="target_container" description="absolute path of the container to load the filters into"/>
  <arg name="input_frame" default="base_link"/>
  <arg name="output_frame" default="base_link"/>
  <arg name="secondary_crop_box" default="mirror" description="name of the geometry the second crop box spans"/>
  <arg name="use_intra_process" default="false"/>

  <arg name="input/pointcloud" default="pointcloud_raw_ex"/>
  <arg name="intermediate/pointcloud" default="self_cropped/pointcloud_ex"/>
  <arg name="output/pointcloud" default="$(var secondary_crop_box)_cropped/pointcloud_ex"/>

  <arg name="crop_box_filter_self_param_path" description="crop box spanning the vehicle body"/>
  <arg name="crop_box_filter_secondary_param_path" description="crop box spanning the geometry cropped after the vehicle body"/>

  <load_composable_node target="$(var target_container)">
    <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::CropBoxFilterComponent" name="crop_box_filter_self">
      <remap from="input" to="$(var input/pointcloud)"/>
      <remap from="output" to="$(var intermediate/pointcloud)"/>
      <param from="$(var crop_box_filter_self_param_path)"/>
      <param name="input_frame" value="$(var input_frame)"/>
      <param name="output_frame" value="$(var output_frame)"/>
      <param name="negative" value="true"/>
      <param name="processing_time_threshold_sec" value="0.01"/>
      <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
    </composable_node>
    <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::CropBoxFilterComponent" name="crop_box_filter_$(var secondary_crop_box)">
      <remap from="input" to="$(var intermediate/pointcloud)"/>
      <remap from="output" to="$(var output/pointcloud)"/>
      <param from="$(var crop_box_filter_secondary_param_path)"/>
      <param name="input_frame" value="$(var input_frame)"/>
      <param name="output_frame" value="$(var output_frame)"/>
      <param name="negative" value="true"/>
      <param name="processing_time_threshold_sec" value="0.01"/>
      <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
    </composable_node>
  </load_composable_node>
</launch>
