<launch>
  <!-- Blockage diagnostics on the raw pointcloud, loaded into an existing container -->
  <arg name="target_container" description="absolute path of the container to load the node into"/>
  <arg name="node_name" default="blockage_diag" description="node name"/>
  <arg name="use_intra_process" default="false" description="use ROS 2 component container communication"/>

  <arg name="input/pointcloud" default="pointcloud_raw_ex" description="raw pointcloud from the sensor driver"/>
  <arg name="output/pointcloud" default="blockage_diag/pointcloud" description="diagnosed pointcloud"/>

  <arg name="cloud_min_angle" default="0.0" description="minimum view angle setting on device"/>
  <arg name="cloud_max_angle" default="360.0" description="maximum view angle setting on device"/>
  <arg name="angle_range" default="[$(var cloud_min_angle), $(var cloud_max_angle)]" description="scanned azimuth range, defaulting to the configured device angles"/>
  <arg name="max_range" default="300.0" description="maximum view range of the sensor"/>
  <arg name="horizontal_ring_id" default="64"/>
  <arg name="vertical_bins" default="128"/>
  <arg name="is_channel_order_top2down" default="true"/>
  <arg name="horizontal_resolution" default="0.4"/>
  <arg
    name="blockage_diagnostics_param_path"
    default="$(find-pkg-share autoware_sensing_launch)/config/blockage_diagnostics.param.yaml"
    description="path to parameter file of blockage diagnostics node"
  />

  <load_composable_node target="$(var target_container)">
    <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::BlockageDiagComponent" name="$(var node_name)">
      <remap from="input" to="$(var input/pointcloud)"/>
      <remap from="output" to="$(var output/pointcloud)"/>
      <param from="$(var blockage_diagnostics_param_path)"/>
      <!-- Values are yaml-typed at load time; angle_range items and the ranges must be float-formatted -->
      <param name="angle_range" value="$(var angle_range)"/>
      <param name="horizontal_ring_id" value="$(var horizontal_ring_id)"/>
      <param name="vertical_bins" value="$(var vertical_bins)"/>
      <param name="is_channel_order_top2down" value="$(var is_channel_order_top2down)"/>
      <param name="max_distance_range" value="$(var max_range)"/>
      <param name="horizontal_resolution" value="$(var horizontal_resolution)"/>
      <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
    </composable_node>
  </load_composable_node>
</launch>
