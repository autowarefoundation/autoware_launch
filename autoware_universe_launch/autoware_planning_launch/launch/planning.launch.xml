<launch>
  <!-- Planning pipeline: mission planning, the trajectory source selected by planning_setting, and the shared validator and evaluator tail, all under the planning namespace -->
  <arg name="planning_config_pkg" default="autoware_planning_config" description="package that ships the planning config/ tree; overriding it requires the same config layout"/>
  <arg name="module_preset" default="default" description="module preset that selects which planning modules launch"/>

  <!-- Module preset: declares the launch_* and planner-type junctions read by the nested launchers -->
  <include file="$(find-pkg-share $(var planning_config_pkg))/config/preset/$(var module_preset)_preset.yaml"/>

  <!-- Pipeline junctions -->
  <arg name="planning_setting" default="rule_based" description="trajectory source; options: `rule_based`, `diffusion_planner`"/>
  <arg name="enable_all_modules_auto_mode" default="false"/>
  <arg name="is_simulation" default="false"/>
  <arg name="launch_remaining_distance_time_calculator" default="false"/>

  <!-- External interfaces -->
  <arg name="input_objects_topic_name" default="/perception/object_recognition/objects"/>
  <arg name="input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud"/>

  <!-- Vehicle -->
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="vehicle_param_file" default="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"/>

  <!-- Artifacts -->
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>

  <!-- Config tree -->
  <let name="planning_config_dir" value="$(find-pkg-share $(var planning_config_pkg))/config"/>
  <let name="planning_common_config_dir" value="$(var planning_config_dir)/scenario_planning/common"/>
  <let name="behavior_path_config_dir" value="$(var planning_config_dir)/scenario_planning/lane_driving/behavior_planning/behavior_path_planner"/>
  <let name="behavior_velocity_config_dir" value="$(var planning_config_dir)/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner"/>
  <let name="motion_planning_config_dir" value="$(var planning_config_dir)/scenario_planning/lane_driving/motion_planning"/>
  <let name="neural_net_planner_config_dir" value="$(var planning_config_dir)/neural_net_planner"/>
  <let name="optimizer_plugins_config_dir" value="$(var neural_net_planner_config_dir)/trajectory_optimizer_plugins"/>

  <!-- Parameter paths: common -->
  <arg name="common_param_path" default="$(var planning_common_config_dir)/common.param.yaml"/>
  <arg name="nearest_search_param_path" default="$(var planning_common_config_dir)/nearest_search.param.yaml"/>
  <arg name="costmap_generator_param_path" default="$(var planning_common_config_dir)/costmap_generator.param.yaml"/>

  <!-- Parameter paths: mission planner -->
  <arg name="mission_planner_param_path" default="$(var planning_config_dir)/mission_planning/mission_planner/mission_planner.param.yaml"/>

  <!-- Parameter paths: behavior path planner -->
  <arg name="behavior_path_planner_common_param_path" default="$(var behavior_path_config_dir)/behavior_path_planner.param.yaml"/>
  <arg name="behavior_path_planner_scene_module_manager_param_path" default="$(var behavior_path_config_dir)/scene_module_manager.param.yaml"/>
  <arg name="behavior_path_planner_drivable_area_expansion_param_path" default="$(var behavior_path_config_dir)/drivable_area_expansion.param.yaml"/>
  <arg name="behavior_path_planner_side_shift_module_param_path" default="$(var behavior_path_config_dir)/side_shift/side_shift.param.yaml"/>
  <arg
    name="behavior_path_planner_static_obstacle_avoidance_module_param_path"
    default="$(var behavior_path_config_dir)/autoware_behavior_path_static_obstacle_avoidance_module/static_obstacle_avoidance.param.yaml"
  />
  <arg
    name="behavior_path_planner_dynamic_obstacle_avoidance_module_param_path"
    default="$(var behavior_path_config_dir)/autoware_behavior_path_dynamic_obstacle_avoidance_module/dynamic_obstacle_avoidance.param.yaml"
  />
  <arg name="behavior_path_planner_avoidance_by_lc_module_param_path" default="$(var behavior_path_config_dir)/avoidance_by_lane_change/avoidance_by_lane_change.param.yaml"/>
  <arg name="behavior_path_planner_sampling_planner_module_param_path" default="$(var behavior_path_config_dir)/sampling_planner/sampling_planner.param.yaml"/>
  <arg name="behavior_path_planner_lane_change_module_param_path" default="$(var behavior_path_config_dir)/lane_change/lane_change.param.yaml"/>
  <arg name="behavior_path_planner_goal_planner_module_param_path" default="$(var behavior_path_config_dir)/goal_planner/goal_planner.param.yaml"/>
  <arg name="behavior_path_planner_start_planner_module_param_path" default="$(var behavior_path_config_dir)/start_planner/start_planner.param.yaml"/>
  <arg name="behavior_path_bidirectional_traffic_module_param_path" default="$(var behavior_path_config_dir)/autoware_behavior_path_bidirectional_traffic_module/bidirectional_traffic.param.yaml"/>
  <arg name="behavior_path_planner_direction_change_module_param_path" default="$(var behavior_path_config_dir)/autoware_behavior_path_direction_change_module/direction_change.param.yaml"/>

  <!-- Parameter paths: path generator -->
  <arg name="path_generator_param_path" default="$(var planning_config_dir)/scenario_planning/lane_driving/behavior_planning/path_generator/path_generator.param.yaml"/>

  <!-- Parameter paths: hazard lights selector -->
  <arg name="hazard_lights_selector_param_path" default="$(var planning_common_config_dir)/autoware_hazard_lights_selector/hazard_lights_selector.param.yaml"/>

  <!-- Parameter paths: behavior velocity planner -->
  <arg name="behavior_velocity_smoother_type_param_path" default="$(var planning_common_config_dir)/autoware_velocity_smoother/Analytical.param.yaml"/>
  <arg name="behavior_velocity_planner_param_path" default="$(var behavior_velocity_config_dir)/behavior_velocity_planner.param.yaml"/>
  <arg name="behavior_velocity_planner_common_param_path" default="$(var behavior_velocity_config_dir)/behavior_velocity_planner_common.param.yaml"/>
  <arg name="behavior_velocity_planner_blind_spot_module_param_path" default="$(var behavior_velocity_config_dir)/blind_spot.param.yaml"/>
  <arg name="behavior_velocity_planner_crosswalk_module_param_path" default="$(var behavior_velocity_config_dir)/crosswalk.param.yaml"/>
  <arg name="behavior_velocity_planner_walkway_module_param_path" default="$(var behavior_velocity_config_dir)/walkway.param.yaml"/>
  <arg name="behavior_velocity_planner_detection_area_module_param_path" default="$(var behavior_velocity_config_dir)/detection_area.param.yaml"/>
  <arg name="behavior_velocity_planner_intersection_module_param_path" default="$(var behavior_velocity_config_dir)/intersection.param.yaml"/>
  <arg name="behavior_velocity_planner_stop_line_module_param_path" default="$(var behavior_velocity_config_dir)/stop_line.param.yaml"/>
  <arg name="behavior_velocity_planner_traffic_light_module_param_path" default="$(var behavior_velocity_config_dir)/traffic_light.param.yaml"/>
  <arg name="behavior_velocity_planner_virtual_traffic_light_module_param_path" default="$(var behavior_velocity_config_dir)/virtual_traffic_light.param.yaml"/>
  <arg name="behavior_velocity_planner_occlusion_spot_module_param_path" default="$(var behavior_velocity_config_dir)/occlusion_spot.param.yaml"/>
  <arg name="behavior_velocity_planner_no_stopping_area_module_param_path" default="$(var behavior_velocity_config_dir)/no_stopping_area.param.yaml"/>
  <arg name="behavior_velocity_planner_roundabout_module_param_path" default="$(var behavior_velocity_config_dir)/roundabout.param.yaml"/>
  <arg name="behavior_velocity_planner_speed_bump_module_param_path" default="$(var behavior_velocity_config_dir)/speed_bump.param.yaml"/>
  <arg name="behavior_velocity_planner_no_drivable_lane_module_param_path" default="$(var behavior_velocity_config_dir)/no_drivable_lane.param.yaml"/>

  <!-- Parameter paths: motion planning -->
  <arg name="elastic_band_smoother_param_path" default="$(var motion_planning_config_dir)/path_smoother/elastic_band_smoother.param.yaml"/>
  <arg name="path_optimizer_param_path" default="$(var motion_planning_config_dir)/autoware_path_optimizer/path_optimizer.param.yaml"/>
  <arg name="path_sampler_param_path" default="$(var motion_planning_config_dir)/path_sampler/path_sampler.param.yaml"/>
  <arg name="surround_obstacle_checker_param_path" default="$(var motion_planning_config_dir)/surround_obstacle_checker/surround_obstacle_checker.param.yaml"/>
  <arg name="motion_velocity_planner_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/motion_velocity_planner.param.yaml"/>
  <arg name="motion_velocity_planner_obstacle_stop_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/obstacle_stop.param.yaml"/>
  <arg name="motion_velocity_planner_obstacle_slow_down_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/obstacle_slow_down.param.yaml"/>
  <arg name="motion_velocity_planner_obstacle_cruise_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/obstacle_cruise.param.yaml"/>
  <arg name="motion_velocity_planner_dynamic_obstacle_stop_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/dynamic_obstacle_stop.param.yaml"/>
  <arg name="motion_velocity_planner_out_of_lane_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/out_of_lane.param.yaml"/>
  <arg name="motion_velocity_planner_obstacle_velocity_limiter_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/obstacle_velocity_limiter.param.yaml"/>
  <arg name="motion_velocity_planner_run_out_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/run_out.param.yaml"/>
  <arg name="motion_velocity_planner_boundary_departure_prevention_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/boundary_departure_prevention.param.yaml"/>
  <arg name="motion_velocity_planner_road_user_stop_module_param_path" default="$(var motion_planning_config_dir)/motion_velocity_planner/road_user_stop.param.yaml"/>
  <arg name="motion_velocity_planner_velocity_smoother_type_param_path" default="$(var planning_common_config_dir)/autoware_velocity_smoother/Analytical.param.yaml"/>

  <!-- Parameter paths: velocity smoother -->
  <arg name="velocity_smoother_param_path" default="$(var planning_common_config_dir)/autoware_velocity_smoother/velocity_smoother.param.yaml"/>
  <arg name="velocity_smoother_type_param_path" default="$(var planning_common_config_dir)/autoware_velocity_smoother/$(var velocity_smoother_type).param.yaml"/>

  <!-- Parameter paths: parking -->
  <arg name="freespace_planner_param_path" default="$(var planning_config_dir)/scenario_planning/parking/freespace_planner/freespace_planner.param.yaml"/>

  <!-- Parameter paths: planning validator -->
  <arg name="planning_validator_param_path" default="$(var planning_common_config_dir)/planning_validator/planning_validator.param.yaml"/>
  <arg name="planning_validator_latency_checker_param_path" default="$(var planning_common_config_dir)/planning_validator/latency_checker.param.yaml"/>
  <arg name="planning_validator_trajectory_checker_param_path" default="$(var planning_common_config_dir)/planning_validator/trajectory_checker.param.yaml"/>
  <arg name="planning_validator_intersection_collision_checker_param_path" default="$(var planning_common_config_dir)/planning_validator/intersection_collision_checker.param.yaml"/>
  <arg name="planning_validator_rear_collision_checker_param_path" default="$(var planning_common_config_dir)/planning_validator/rear_collision_checker.param.yaml"/>

  <!-- Parameter paths: neural network based planner -->
  <arg name="diffusion_planner_param_path" default="$(var neural_net_planner_config_dir)/diffusion_planner.param.yaml"/>
  <arg name="trajectory_processor_param_path" default="$(var neural_net_planner_config_dir)/trajectory_processor.param.yaml"/>
  <arg name="jerk_filtered_smoother_param_path" default="$(var planning_common_config_dir)/autoware_velocity_smoother/JerkFiltered.param.yaml"/>
  <arg name="common_smoother_param_path" default="$(var planning_common_config_dir)/common.param.yaml"/>
  <arg name="elastic_band_param_path" default="$(var motion_planning_config_dir)/path_smoother/elastic_band_smoother.param.yaml"/>
  <arg name="trajectory_point_fixer_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_point_fixer.param.yaml"/>
  <arg name="trajectory_extender_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_extender.param.yaml"/>
  <arg name="trajectory_spline_smoother_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_spline_smoother.param.yaml"/>
  <arg name="trajectory_qp_smoother_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_qp_smoother.param.yaml"/>
  <arg name="trajectory_velocity_optimizer_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_velocity_optimizer.param.yaml"/>
  <arg name="trajectory_kinematic_feasibility_enforcer_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_kinematic_feasibility_enforcer.param.yaml"/>
  <arg name="trajectory_mpt_optimizer_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_mpt_optimizer.param.yaml"/>
  <arg name="trajectory_temporal_mpt_optimizer_param_path" default="$(var optimizer_plugins_config_dir)/trajectory_temporal_mpt_optimizer.param.yaml"/>

  <group>
    <push-ros-namespace namespace="planning"/>
    <!-- manual lane change handler module -->
    <group>
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share autoware_manual_lane_change_handler)/launch/manual_lane_change_handler.launch.xml">
        <arg name="mission_planner_param_path" value="$(var mission_planner_param_path)"/>
      </include>
    </group>
    <!-- mission planning module -->
    <group>
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share autoware_planning_launch)/launch/mission_planning/mission_planning.launch.xml">
        <arg name="mission_planner_param_path" value="$(var mission_planner_param_path)"/>
      </include>
    </group>

    <!-- scenario planning module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)">
      <push-ros-namespace namespace="scenario_planning"/>
      <include file="$(find-pkg-share autoware_planning_launch)/launch/scenario_planning/scenario_planning.launch.xml">
        <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
        <arg name="is_simulation" value="$(var is_simulation)"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
      </include>
    </group>

    <!-- diffusion planner module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)">
      <include file="$(find-pkg-share autoware_planning_launch)/launch/learning_based_planning/diffusion_planner.launch.xml">
        <arg name="is_simulation" value="$(var is_simulation)"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="data_path" value="$(var data_path)"/>
        <arg name="diffusion_planner_param_path" value="$(var diffusion_planner_param_path)"/>
        <arg name="trajectory_processor_param_path" value="$(var trajectory_processor_param_path)"/>
        <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
        <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
        <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
        <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
        <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
        <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
        <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
        <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
        <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
        <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
        <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
        <arg name="trajectory_temporal_mpt_optimizer_param_path" value="$(var trajectory_temporal_mpt_optimizer_param_path)"/>
      </include>
    </group>

    <!-- planning validator -->
    <group>
      <let name="validator_input_trajectory" value="/planning/trajectory_generator/trajectory" if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"/>
      <let name="validator_input_trajectory" value="/planning/scenario_planning/velocity_smoother/trajectory" if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"/>
      <include file="$(find-pkg-share autoware_planning_validator)/launch/planning_validator.launch.xml">
        <arg name="container_type" value="component_container_mt"/>
        <arg name="input_trajectory_topic_name" value="$(var validator_input_trajectory)"/>
        <arg name="output_trajectory" value="/planning/trajectory"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="planning_validator_param_path" value="$(var planning_validator_param_path)"/>
        <arg name="planning_validator_latency_checker_param_path" value="$(var planning_validator_latency_checker_param_path)"/>
        <arg name="planning_validator_trajectory_checker_param_path" value="$(var planning_validator_trajectory_checker_param_path)"/>
        <arg name="planning_validator_intersection_collision_checker_param_path" value="$(var planning_validator_intersection_collision_checker_param_path)"/>
        <arg name="planning_validator_rear_collision_checker_param_path" value="$(var planning_validator_rear_collision_checker_param_path)"/>
      </include>
    </group>

    <!-- planning evaluator -->
    <group>
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"
      />
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/scenario_planning/lane_driving/motion_planning/path_optimizer/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"
      />

      <let
        name="evaluator_input_objects"
        value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/predicted_objects"
        if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"
      />
      <let name="evaluator_input_objects" value="/perception/object_recognition/objects" if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"/>

      <include file="$(find-pkg-share autoware_planning_evaluator)/launch/planning_evaluator.launch.xml">
        <arg name="input/reference_trajectory" value="$(var evaluator_input_reference_trajectory)"/>
        <arg name="input/objects" value="$(var evaluator_input_objects)"/>
      </include>
    </group>

    <!-- mission remaining distance and time calculator -->
    <group if="$(var launch_remaining_distance_time_calculator)">
      <include file="$(find-pkg-share autoware_remaining_distance_time_calculator)/launch/remaining_distance_time_calculator.launch.xml"/>
    </group>
  </group>
</launch>
