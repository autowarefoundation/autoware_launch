<?xml version="1.0"?>
<!-- Fine-detection chain for one traffic light camera: map based detector proposes rough ROIs, the fine detector refines them, classifiers label them. -->
<launch>
  <arg name="perception_config_pkg" default="autoware_perception_launch" description="package that ships the perception config/ tree; overriding it requires the same config layout"/>
  <arg name="camera_namespace" description="camera namespace, e.g. camera6"/>
  <arg name="enable_image_decompressor" default="true" description="decompress the compressed camera image into the raw image topic"/>
  <arg name="input/vector_map" default="/map/vector_map"/>
  <arg name="input/route" default="/planning/mission_planning/route"/>

  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>
  <arg name="map_based_detector_param_path" default="$(find-pkg-share autoware_traffic_light_map_based_detector)/config/traffic_light_map_based_detector.param.yaml"/>
  <arg name="fine_detector_param_path" default="$(find-pkg-share $(var perception_config_pkg))/config/traffic_light_recognition/traffic_light_fine_detector/traffic_light_fine_detector.param.yaml"/>
  <arg name="car_classifier_param_path" default="$(find-pkg-share $(var perception_config_pkg))/config/traffic_light_recognition/traffic_light_classifier/car_traffic_light_classifier.param.yaml"/>
  <arg
    name="pedestrian_classifier_param_path"
    default="$(find-pkg-share $(var perception_config_pkg))/config/traffic_light_recognition/traffic_light_classifier/pedestrian_traffic_light_classifier.param.yaml"
  />
  <arg name="lamp_recognizer_ml_param_path" default="$(var data_path)/traffic_light_classifier/lamp_recognizer_ml.param.yaml"/>
  <arg name="roi_visualizer_param_path" default="$(find-pkg-share $(var perception_config_pkg))/config/traffic_light_recognition/traffic_light_visualization/traffic_light_roi_visualizer.param.yaml"/>
  <arg name="fine_detector_model_path" default="$(var data_path)/traffic_light_fine_detector/tlr_car_ped_yolox_s_batch_6.onnx"/>
  <arg name="fine_detector_label_path" default="$(var data_path)/traffic_light_fine_detector/tlr_labels.txt"/>
  <arg name="car_classifier_model_path" default="$(var data_path)/traffic_light_classifier/traffic_light_classifier_mobilenetv2_batch_6.onnx"/>
  <arg name="car_classifier_label_path" default="$(var data_path)/traffic_light_classifier/lamp_labels.txt"/>
  <arg name="pedestrian_classifier_model_path" default="$(var data_path)/traffic_light_classifier/ped_traffic_light_classifier_mobilenetv2_batch_6.onnx"/>
  <arg name="pedestrian_classifier_label_path" default="$(var data_path)/traffic_light_classifier/lamp_labels_ped.txt"/>
  <arg name="car_classifier_type" default="1" description="0=HSVFilter, 1=CNN, 2=LampRecognizer"/>
  <arg name="pedestrian_classifier_type" default="1" description="0=HSVFilter, 1=CNN, 2=LampRecognizer"/>

  <!-- per-camera topics fixed by the sensing and recognition namespace conventions; the signals topic is published by the occlusion predictor -->
  <let name="camera/image" value="/sensing/camera/$(var camera_namespace)/image_raw"/>
  <let name="camera/camera_info" value="/sensing/camera/$(var camera_namespace)/camera_info"/>
  <let name="camera/rois" value="/perception/traffic_light_recognition/$(var camera_namespace)/detection/rois"/>
  <let name="camera/traffic_signals" value="/perception/traffic_light_recognition/$(var camera_namespace)/classification/traffic_signals"/>

  <group>
    <push-ros-namespace namespace="$(var camera_namespace)"/>

    <!-- camera_info under the recognition namespace for the multi camera fusion -->
    <node pkg="topic_tools" exec="relay" name="traffic_light_camera_info_relay" args="$(var camera/camera_info) camera_info"/>

    <group>
      <push-ros-namespace namespace="detection"/>
      <include file="$(find-pkg-share autoware_traffic_light_map_based_detector)/launch/traffic_light_map_based_detector.launch.xml">
        <arg name="input/vector_map" value="$(var input/vector_map)"/>
        <arg name="input/camera_info" value="$(var camera/camera_info)"/>
        <arg name="input/route" value="$(var input/route)"/>
        <arg name="expect/rois" value="expect/rois"/>
        <arg name="output/rois" value="rough/rois"/>
        <arg name="param_path" value="$(var map_based_detector_param_path)"/>
      </include>
    </group>

    <node_container pkg="rclcpp_components" exec="component_container_mt" name="traffic_light_node_container" namespace="" output="both">
      <composable_node pkg="autoware_traffic_light_fine_detector" plugin="autoware::traffic_light::TrafficLightFineDetectorNode" name="traffic_light_fine_detector" namespace="detection">
        <param from="$(var fine_detector_param_path)" allow_substs="true"/>
        <param name="build_only" value="false"/>
        <param name="model_path" value="$(var fine_detector_model_path)"/>
        <param name="label_path" value="$(var fine_detector_label_path)"/>
        <remap from="~/input/image" to="$(var camera/image)"/>
        <remap from="~/input/rois" to="rough/rois"/>
        <remap from="~/expect/rois" to="expect/rois"/>
        <remap from="~/output/rois" to="$(var camera/rois)"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
      <composable_node pkg="autoware_traffic_light_classifier" plugin="autoware::traffic_light::TrafficLightClassifierNode" name="car_traffic_light_classifier" namespace="classification">
        <param from="$(var car_classifier_param_path)" allow_substs="true"/>
        <param from="$(var lamp_recognizer_ml_param_path)" allow_substs="true"/>
        <param name="build_only" value="false"/>
        <param name="model_path" value="$(var car_classifier_model_path)"/>
        <param name="label_path" value="$(var car_classifier_label_path)"/>
        <param name="classifier_type" value="$(var car_classifier_type)"/>
        <remap from="~/input/image" to="$(var camera/image)"/>
        <remap from="~/input/rois" to="$(var camera/rois)"/>
        <remap from="~/output/traffic_signals" to="car/traffic_signals"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
      <composable_node pkg="autoware_traffic_light_classifier" plugin="autoware::traffic_light::TrafficLightClassifierNode" name="pedestrian_traffic_light_classifier" namespace="classification">
        <param from="$(var pedestrian_classifier_param_path)" allow_substs="true"/>
        <param from="$(var lamp_recognizer_ml_param_path)" allow_substs="true"/>
        <param name="build_only" value="false"/>
        <param name="model_path" value="$(var pedestrian_classifier_model_path)"/>
        <param name="label_path" value="$(var pedestrian_classifier_label_path)"/>
        <param name="classifier_type" value="$(var pedestrian_classifier_type)"/>
        <remap from="~/input/image" to="$(var camera/image)"/>
        <remap from="~/input/rois" to="$(var camera/rois)"/>
        <remap from="~/output/traffic_signals" to="pedestrian/traffic_signals"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
      <composable_node pkg="autoware_traffic_light_visualization" plugin="autoware::traffic_light::TrafficLightRoiVisualizerNode" name="traffic_light_roi_visualizer">
        <param from="$(var roi_visualizer_param_path)" allow_substs="true"/>
        <param name="use_high_accuracy_detection" value="true"/>
        <remap from="~/input/image" to="$(var camera/image)"/>
        <remap from="~/input/rois" to="$(var camera/rois)"/>
        <remap from="~/input/rough/rois" to="detection/rough/rois"/>
        <remap from="~/input/traffic_signals" to="$(var camera/traffic_signals)"/>
        <remap from="~/output/image" to="debug/rois"/>
        <remap from="~/output/image/compressed" to="debug/rois/compressed"/>
        <remap from="~/output/image/compressedDepth" to="debug/rois/compressedDepth"/>
        <remap from="~/output/image/theora" to="debug/rois/theora"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </node_container>

    <!-- Image decompressor; supplies the raw image topic when the camera publishes compressed only -->
    <group if="$(var enable_image_decompressor)">
      <load_composable_node target="/perception/traffic_light_recognition/$(var camera_namespace)/traffic_light_node_container">
        <composable_node
          pkg="autoware_image_transport_decompressor"
          plugin="autoware::image_preprocessor::ImageTransportDecompressor"
          name="traffic_light_image_decompressor"
          namespace="/perception/traffic_light_recognition/$(var camera_namespace)"
        >
          <param name="encoding" value="rgb8"/>
          <remap from="~/input/compressed_image" to="$(var camera/image)/compressed"/>
          <remap from="~/output/raw_image" to="$(var camera/image)"/>
          <extra_arg name="use_intra_process_comms" value="true"/>
        </composable_node>
      </load_composable_node>
    </group>
  </group>
</launch>
