<?xml version="1.0"?>
<launch>
  <!-- Current namespace -->
  <arg name="pipeline_ns" description="pipeline namespace"/>
  <arg name="node/pointcloud_container" description="container for the fusion nodes"/>
  <arg name="output/objects" default="objects"/>
  <arg name="input/concatenation_info"/>
  <arg name="input/pointcloud"/>
  <arg name="irregular_object_crop_box_filter_node_param_path"/>
  <arg name="irregular_object_scan_ground_filter_node_param_path"/>
  <arg name="irregular_object_roi_pointcloud_fusion_node_param_path"/>
  <arg name="irregular_object_fusion_camera_param_path"/>
  <arg name="sync_param_path"/>
  <!-- small unknown object detector -->
  <group>
    <push-ros-namespace namespace="$(var pipeline_ns)"/>
    <group>
      <include file="$(find-pkg-share autoware_perception_launch)/launch/object_recognition/detection/detector/irregular_object_detector.launch.xml">
        <arg name="target_container" value="$(var node/pointcloud_container)"/>
        <arg name="input/concatenation_info" value="$(var input/concatenation_info)"/>
        <arg name="input/pointcloud" value="$(var input/pointcloud)"/>
        <arg name="output/clusters" value="clusters"/>
        <arg name="crop_box_filter_node_param_path" value="$(var irregular_object_crop_box_filter_node_param_path)"/>
        <arg name="scan_ground_filter_node_param_path" value="$(var irregular_object_scan_ground_filter_node_param_path)"/>
        <arg name="roi_pointcloud_fusion_node_param_path" value="$(var irregular_object_roi_pointcloud_fusion_node_param_path)"/>
        <arg name="fusion_camera_param_path" value="$(var irregular_object_fusion_camera_param_path)"/>
        <arg name="sync_param_path" value="$(var sync_param_path)"/>
      </include>
    </group>
    <!-- Convex Hull conversion from DynamicObjectsWithFeatureArray to DynamicObjects -->
    <group>
      <include file="$(find-pkg-share autoware_detected_object_feature_remover)/launch/detected_object_feature_remover.launch.xml">
        <arg name="input" value="clusters"/>
        <arg name="output" value="$(var output/objects)"/>
        <arg name="run_convex_hull_conversion" value="true"/>
      </include>
    </group>
  </group>
</launch>
