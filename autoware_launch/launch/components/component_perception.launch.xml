<?xml version="1.0"?>
<launch>
  <!-- Lidar perception pipeline: common pointcloud preprocess, obstacle segmentation, occupancy grid map, and lidar object recognition; the sensor kits in this repository are lidar-only -->
  <arg
    name="launch_pointcloud_container"
    default="false"
    description="if true, launch pointcloud container. Please note that it is not intended to launch pointcloud_container_name with the same name in other launch files."
  />
  <arg name="pointcloud_container_name" description="name of pointcloud container"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_model" default="sample_vehicle"/>

  <!-- Pointcloud container -->
  <group if="$(var launch_pointcloud_container)">
    <include file="$(find-pkg-share autoware_launch)/launch/pointcloud_container.launch.py">
      <arg name="use_multithread" value="true"/>
      <arg name="container_name" value="$(var pointcloud_container_name)"/>
    </include>
  </group>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <arg name="use_semantic_segmentation_ptv3" default="false" description="use semantic segmentation ptv3 for ground segmentation"/>

  <arg name="use_low_height_cropbox" default="false" description="use low height crop filter in clustering"/>
  <arg name="use_vector_map" default="true" description="use vector map in prediction"/>
  <arg name="use_pointcloud_map" default="true" description="use pointcloud map in detection"/>
  <arg name="use_perception_online_evaluator" default="false" description="launch perception online evaluator"/>
  <arg name="use_perception_analytics_publisher" default="true" description="launch perception analytics publisher"/>
  <arg name="use_object_validator" default="false" description="use obstacle_pointcloud based object validator"/>
  <arg name="use_obstacle_segmentation_single_frame_filter" default="false" description="use single frame filter at the ground segmentation"/>
  <arg name="use_obstacle_segmentation_time_series_filter" default="true" description="use time series filter at the ground segmentation"/>
  <arg name="use_cuda_ground_segmentation" default="false" description="use cuda ground segmentation filter at the ground segmentation"/>
  <arg name="tracker_publish_merged_objects" default="false"/>

  <arg name="occupancy_grid_map_method" default="pointcloud_based" description="options: pointcloud_based, laserscan_based, multi_lidar_pointcloud_based"/>
  <arg name="occupancy_grid_map_updater" default="binary_bayes_filter" description="options: binary_bayes_filter"/>
  <arg name="detected_objects_validation_method" default="obstacle_pointcloud" description="options: obstacle_pointcloud, occupancy_grid (must be used with laserscan_based_occupancy_grid_map)"/>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>
  <arg name="lidar_detection_model" default="centerpoint" description="If the model name is not declared, the default model in the detection composition will be used"/>
  <arg name="ptv3_model_path" default="$(var data_path)/ptv3"/>

  <!-- External interfaces -->
  <arg name="input/pointcloud" default="/sensing/lidar/concatenated/pointcloud" description="input pointcloud topic of the perception pipeline"/>

  <!-- Downsample pointcloud for perception usage -->
  <arg name="downsample_perception_common_pointcloud" default="false"/>
  <arg name="cuda_pointcloud_preprocessing" default="false"/>
  <arg name="common_downsample_voxel_size_x" default="0.05"/>
  <arg name="common_downsample_voxel_size_y" default="0.05"/>
  <arg name="common_downsample_voxel_size_z" default="0.05"/>

  <group scoped="false" if="$(var use_semantic_segmentation_ptv3)">
    <let name="use_object_validator" value="false"/>
  </group>
  <let name="occupancy_grid_map_method_full" value="$(var occupancy_grid_map_method)_occupancy_grid_map"/>

  <!-- Perception module -->
  <group>
    <push-ros-namespace namespace="perception"/>
    <!-- Perception common preprocess -->
    <let name="downsampled_pointcloud" value="/perception/common/pointcloud"/>
    <let name="perception_pointcloud" value="$(var input/pointcloud)" unless="$(var downsample_perception_common_pointcloud)"/>
    <let name="perception_pointcloud" value="$(var downsampled_pointcloud)" if="$(var downsample_perception_common_pointcloud)"/>
    <group if="$(var downsample_perception_common_pointcloud)">
      <push-ros-namespace namespace="common"/>
      <include file="$(find-pkg-share autoware_perception_launch)/launch/common/pointcloud_downsample.launch.xml">
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="cuda_pointcloud_preprocessing" value="$(var cuda_pointcloud_preprocessing)"/>
        <arg name="input/pointcloud" value="$(var input/pointcloud)"/>
        <arg name="output/pointcloud" value="$(var downsampled_pointcloud)"/>
        <arg name="common_downsample_voxel_size_x" value="$(var common_downsample_voxel_size_x)"/>
        <arg name="common_downsample_voxel_size_y" value="$(var common_downsample_voxel_size_y)"/>
        <arg name="common_downsample_voxel_size_z" value="$(var common_downsample_voxel_size_z)"/>
      </include>
    </group>

    <!-- Object segmentation module -->
    <group>
      <push-ros-namespace namespace="obstacle_segmentation"/>
      <let name="obstacle_segmentation_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
      <!-- The outlier filters chain after the ground filter; each enabled stage's output feeds the next -->
      <let
        name="use_obstacle_segmentation_outlier_filter"
        value="$(eval &quot;'$(var use_obstacle_segmentation_single_frame_filter)' == 'true' or '$(var use_obstacle_segmentation_time_series_filter)' == 'true'&quot;)"
      />
      <let name="no_ground_pointcloud" value="$(var obstacle_segmentation_pointcloud)"/>
      <let name="no_ground_pointcloud" value="/perception/obstacle_segmentation/single_frame/pointcloud" if="$(var use_obstacle_segmentation_outlier_filter)"/>
      <let name="single_frame_filter_output" value="$(var obstacle_segmentation_pointcloud)"/>
      <let name="single_frame_filter_output" value="/perception/obstacle_segmentation/single_frame/filtered/pointcloud" if="$(var use_obstacle_segmentation_time_series_filter)"/>
      <let name="time_series_filter_input" value="$(var no_ground_pointcloud)"/>
      <let name="time_series_filter_input" value="$(var single_frame_filter_output)" if="$(var use_obstacle_segmentation_single_frame_filter)"/>

      <group if="$(var use_cuda_ground_segmentation)">
        <include file="$(find-pkg-share autoware_perception_launch)/launch/obstacle_segmentation/ground_segmentation_rule_based_cuda.launch.xml">
          <arg name="target_container" value="$(var pointcloud_container_name)"/>
          <arg name="input/pointcloud" value="$(var perception_pointcloud)"/>
          <arg name="output/pointcloud" value="$(var obstacle_segmentation_pointcloud)"/>
        </include>
      </group>
      <group unless="$(var use_cuda_ground_segmentation)">
        <group if="$(var use_semantic_segmentation_ptv3)">
          <include file="$(find-pkg-share autoware_perception_launch)/launch/obstacle_segmentation/ground_segmentation_ml.launch.xml">
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
            <arg name="input/pointcloud" value="$(var perception_pointcloud)"/>
            <arg name="output/pointcloud" value="$(var obstacle_segmentation_pointcloud)"/>
            <arg name="data_path" value="$(var data_path)"/>
            <arg name="model_path" value="$(var ptv3_model_path)"/>
          </include>
        </group>
        <group unless="$(var use_semantic_segmentation_ptv3)">
          <include file="$(find-pkg-share autoware_perception_launch)/launch/obstacle_segmentation/ground_segmentation_rule_based.launch.xml">
            <arg name="target_container" value="$(var pointcloud_container_name)"/>
            <arg name="base_frame" value="base_link"/>
            <arg name="use_intra_process" value="true"/>
            <arg name="input/pointcloud" value="$(var perception_pointcloud)"/>
            <arg name="output/pointcloud" value="$(var no_ground_pointcloud)"/>
          </include>
          <group if="$(var use_obstacle_segmentation_single_frame_filter)">
            <include file="$(find-pkg-share autoware_perception_launch)/launch/obstacle_segmentation/ground_segmentation_outlier_filter_single_frame.launch.xml">
              <arg name="target_container" value="$(var pointcloud_container_name)"/>
              <arg name="base_frame" value="base_link"/>
              <arg name="use_intra_process" value="true"/>
              <arg name="input/pointcloud" value="$(var no_ground_pointcloud)"/>
              <arg name="output/pointcloud" value="$(var single_frame_filter_output)"/>
            </include>
          </group>
          <group if="$(var use_obstacle_segmentation_time_series_filter)">
            <include file="$(find-pkg-share autoware_perception_launch)/launch/obstacle_segmentation/ground_segmentation_outlier_filter_time_series.launch.xml">
              <arg name="target_container" value="$(var pointcloud_container_name)"/>
              <arg name="use_intra_process" value="true"/>
              <arg name="input/pointcloud" value="$(var time_series_filter_input)"/>
              <arg name="output/pointcloud" value="$(var obstacle_segmentation_pointcloud)"/>
            </include>
          </group>
        </group>
      </group>
    </group>

    <!-- Occupancy grid map module -->
    <group>
      <push-ros-namespace namespace="occupancy_grid_map"/>
      <let name="unfiltered_obstacle_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
      <let
        name="unfiltered_obstacle_pointcloud"
        value="/perception/obstacle_segmentation/single_frame/pointcloud"
        if="$(eval &quot;'$(var use_cuda_ground_segmentation)' == 'false' and '$(var use_semantic_segmentation_ptv3)' == 'false' and '$(var use_obstacle_segmentation_single_frame_filter)' == 'true'&quot;)"
      />
      <let
        name="unfiltered_obstacle_pointcloud"
        value="/perception/obstacle_segmentation/single_frame/pointcloud"
        if="$(eval &quot;'$(var use_cuda_ground_segmentation)' == 'false' and '$(var use_semantic_segmentation_ptv3)' == 'false' and '$(var use_obstacle_segmentation_time_series_filter)' == 'true'&quot;)"
      />
      <include file="$(find-pkg-share autoware_perception_launch)/launch/occupancy_grid_map/probabilistic_occupancy_grid_map.launch.xml">
        <arg name="input/obstacle_pointcloud" value="$(var unfiltered_obstacle_pointcloud)"/>
        <arg name="input/raw_pointcloud" value="$(var perception_pointcloud)"/>
        <arg name="output" value="/perception/occupancy_grid_map/map"/>
        <arg name="use_intra_process" value="true"/>
        <arg name="use_multithread" value="true"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="occupancy_grid_map_method" value="$(var occupancy_grid_map_method_full)"/>
        <arg name="occupancy_grid_map_updater" value="$(var occupancy_grid_map_updater)"/>
      </include>
    </group>

    <!-- Object recognition module -->
    <group>
      <push-ros-namespace namespace="object_recognition"/>
      <include file="$(find-pkg-share autoware_perception_launch)/launch/object_recognition/object_recognition_lidar.launch.xml">
        <arg name="lidar_detection_model" value="$(var lidar_detection_model)"/>
        <arg name="use_validator" value="$(var use_object_validator)"/>
        <arg name="use_semantic_segmentation_ptv3" value="$(var use_semantic_segmentation_ptv3)"/>
        <arg name="use_vector_map" value="$(var use_vector_map)"/>
        <arg name="tracker_publish_merged_objects" value="$(var tracker_publish_merged_objects)"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="input/pointcloud" value="$(var perception_pointcloud)"/>
        <arg name="objects_validation_method" value="$(var detected_objects_validation_method)"/>
        <arg name="use_pointcloud_map" value="$(var use_pointcloud_map)"/>
        <arg name="use_low_height_cropbox" value="$(var use_low_height_cropbox)"/>
        <arg name="data_path" value="$(var data_path)"/>
      </include>
    </group>
  </group>

  <!-- perception evaluator -->
  <group if="$(var use_perception_online_evaluator)">
    <include file="$(find-pkg-share autoware_perception_online_evaluator)/launch/perception_online_evaluator.launch.xml"/>
  </group>

  <!-- perception analytics publisher-->
  <group if="$(var use_perception_analytics_publisher)">
    <include file="$(find-pkg-share autoware_perception_online_evaluator)/launch/perception_analytics_publisher.launch.xml"/>
  </group>
</launch>
