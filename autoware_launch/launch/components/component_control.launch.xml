<?xml version="1.0"?>
<launch>
  <!-- Control pipeline: the module preset and the controller algorithms are product-level choices; parameter files are resolved inside autoware_control_launch -->
  <arg name="module_preset" default="default"/>
  <arg name="lateral_controller_mode" default="mpc"/>
  <arg name="longitudinal_controller_mode" default="pid"/>
  <arg name="use_individual_control_param" default="false"/>
  <arg name="use_aeb_autoware_state_check" default="true"/>
  <arg name="check_external_emergency_heartbeat" default="false"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>

  <!-- External interfaces -->
  <arg name="control_input_objects_topic_name" default="/perception/object_recognition/objects"/>
  <arg name="control_input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud"/>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <include file="$(find-pkg-share autoware_control_launch)/launch/control.launch.xml">
    <arg name="module_preset" value="$(var module_preset)"/>
    <arg name="lateral_controller_mode" value="$(var lateral_controller_mode)"/>
    <arg name="longitudinal_controller_mode" value="$(var longitudinal_controller_mode)"/>
    <arg name="use_individual_control_param" value="$(var use_individual_control_param)"/>
    <arg name="use_aeb_autoware_state_check" value="$(var use_aeb_autoware_state_check)"/>
    <arg name="check_external_emergency_heartbeat" value="$(var check_external_emergency_heartbeat)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>

    <!-- Input topic parameters -->
    <arg name="input_objects_topic_name" value="$(var control_input_objects_topic_name)"/>
    <arg name="input_pointcloud_topic_name" value="$(var control_input_pointcloud_topic_name)"/>
  </include>
</launch>
