<launch>
  <!-- planning module -->
  <!-- diffusion planner -->
  <arg name="diffusion_planner_param_path"/>

  <!-- input topic parameters -->
  <arg name="input_objects_topic_name" default="/perception/object_recognition/objects"/>
  <arg name="input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud"/>

  <!-- trajectory modifier -->
  <arg name="trajectory_modifier_param_path"/>
  <!-- trajectory optimizer -->
  <arg name="trajectory_optimizer_param_path"/>
  <arg name="jerk_filtered_smoother_param_path"/>
  <arg name="velocity_smoother_param_path"/>
  <arg name="common_smoother_param_path"/>
  <arg name="elastic_band_param_path"/>
  <arg name="trajectory_point_fixer_param_path"/>
  <arg name="trajectory_extender_param_path"/>
  <arg name="trajectory_spline_smoother_param_path"/>
  <arg name="trajectory_qp_smoother_param_path"/>
  <arg name="trajectory_velocity_optimizer_param_path"/>
  <arg name="trajectory_kinematic_feasibility_enforcer_param_path"/>
  <arg name="trajectory_mpt_optimizer_param_path"/>

  <!-- mission planner -->
  <arg name="mission_planner_param_path"/>
  <arg name="launch_remaining_distance_time_calculator" default="false"/>
  <arg name="launch_proximity_hazard_object_checker" default="true"/>

  <!-- minimum rule-based planner param paths -->
  <arg name="minimum_rule_base_planner_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/minimum_rule_based_planner/minimum_rule_based_planner.param.yaml"/>
  <arg
    name="minimum_rule_base_planner_elastic_band_smoother_param_path"
    default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/minimum_rule_based_planner/elastic_band_smoother.param.yaml"
  />
  <arg
    name="minimum_rule_base_planner_jerk_filtered_smoother_param_path"
    default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/minimum_rule_based_planner/jerk_filtered_smoother.param.yaml"
  />

  <arg name="disable_diffusion_planner_node" default="false"/>
  <arg name="disable_diffusion_planner_trajectory" default="false"/>
  <arg name="enable_minimum_rule_based_planner" default="false"/>
  <arg name="enable_diffusion_planner_dummy_gate" default="false"/>
  <let name="diffusion_candidate_trajectories_topic" value="/planning/generator/diffusion_planner/candidate_trajectories" unless="$(var disable_diffusion_planner_trajectory)"/>
  <let name="diffusion_candidate_trajectories_topic" value="/planning/generator/diffusion_planner/debug/candidate_trajectories" if="$(var disable_diffusion_planner_trajectory)"/>
  <!-- when the dummy gate is enabled, the optimizer publishes to an intermediate topic and the gate forwards it to the selector input -->
  <let name="diffusion_optimizer_output_topic" value="/planning/generator/candidate_trajectories" unless="$(var enable_diffusion_planner_dummy_gate)"/>
  <let name="diffusion_optimizer_output_topic" value="/planning/generator/diffusion_planner/optimized_candidate_trajectories" if="$(var enable_diffusion_planner_dummy_gate)"/>

  <node pkg="demo_nodes_cpp" exec="parameter_blackboard" name="velocity_smoother" namespace="/planning/scenario_planning" output="screen">
    <param name="max_velocity" value="16.6"/>
  </node>

  <!-- trajectory selector param paths -->
  <arg name="trajectory_concatenator_param_path"/>
  <arg name="trajectory_validator_param_path"/>
  <arg name="trajectory_ranker_param_path"/>

  <group>
    <push-ros-namespace namespace="planning"/>
    <!-- mission planning module -->
    <group>
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share tier4_planning_launch)/launch/mission_planning/mission_planning.launch.xml">
        <arg name="mission_planner_param_path" value="$(var mission_planner_param_path)"/>
      </include>
    </group>

    <group>
      <!-- trajectory generator -->
      <group>
        <push-ros-namespace namespace="trajectory_generator"/>
        <!-- neural network based planning module -->
        <group unless="$(var disable_diffusion_planner_node)">
          <push-ros-namespace namespace="neural_network_based_planner"/>
          <include file="$(find-pkg-share autoware_diffusion_planner)/launch/diffusion_planner.launch.xml">
            <arg name="diffusion_planner_param_path" value="$(var diffusion_planner_param_path)"/>
            <arg name="input_odometry" value="/localization/kinematic_state"/>
            <arg name="input_acceleration" value="/localization/acceleration"/>
            <arg name="input_route" value="/planning/mission_planning/route"/>
            <arg name="input_traffic_signals" value="/perception/traffic_light_recognition/traffic_signals"/>
            <arg name="input_tracked_objects" value="/perception/object_recognition/tracking/objects"/>
            <arg name="input_vector_map" value="/map/vector_map"/>
            <arg name="input_turn_indicators" value="/vehicle/status/turn_indicators_status"/>
            <arg name="debug/output_traffic_signal" value="/planning/scenario_planning/lane_driving/behavior_planning/debug/traffic_signal"/>
            <arg name="output_trajectories" value="$(var diffusion_candidate_trajectories_topic)"/>
            <arg name="output_turn_indicators" value="/planning/turn_indicators_cmd"/>
          </include>
        </group>
        <group>
          <include file="$(find-pkg-share autoware_trajectory_modifier)/launch/trajectory_modifier.launch.xml">
            <arg name="trajectory_modifier_param_path" value="$(var trajectory_modifier_param_path)"/>
            <arg name="input_candidate_trajectories" value="/planning/generator/diffusion_planner/candidate_trajectories"/>
            <arg name="output_candidate_trajectories" value="/planning/generator/diffusion_planner/modified_candidate_trajectories"/>
            <arg name="input_odometry" value="/localization/kinematic_state"/>
            <arg name="input_acceleration" value="/localization/acceleration"/>
            <arg name="input_objects" value="$(var input_objects_topic_name)"/>
            <arg name="input_pointcloud" value="$(var input_pointcloud_topic_name)"/>
            <arg name="input_vector_map" value="/map/vector_map"/>
            <arg name="input_traffic_signals" value="/perception/traffic_light_recognition/traffic_signals"/>
            <arg name="input_route" value="/planning/mission_planning/route"/>
          </include>
          <include file="$(find-pkg-share autoware_trajectory_optimizer)/launch/trajectory_optimizer.launch.xml">
            <arg name="trajectory_optimizer_param_path" value="$(var trajectory_optimizer_param_path)"/>
            <arg name="input_trajectories" value="/planning/generator/diffusion_planner/modified_candidate_trajectories"/>
            <arg name="output_traj" value="/planning/generator/trajectory_optimizer/debug/trajectory"/>
            <arg name="output_trajectories" value="$(var diffusion_optimizer_output_topic)"/>
            <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
            <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
            <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
            <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
            <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
            <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
            <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
            <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
            <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
            <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
            <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
          </include>

          <!-- trajectory dummy gate (verification or debug only) -->
          <group if="$(var enable_diffusion_planner_dummy_gate)">
            <include file="$(find-pkg-share autoware_trajectory_dummy_gate)/launch/trajectory_dummy_gate.launch.xml">
              <arg name="gate_input_trajectories" value="/planning/generator/diffusion_planner/optimized_candidate_trajectories"/>
              <arg name="gate_output_trajectories" value="/planning/generator/candidate_trajectories"/>
              <arg name="override_topic" value="/planning/trajectory_selector/diffusion_planner_override"/>
            </include>
          </group>
        </group>

        <!-- minimum rule-based planner -->
        <group if="$(var enable_minimum_rule_based_planner)">
          <push-ros-namespace namespace="minimum_rule_based_planner"/>
          <include file="$(find-pkg-share autoware_minimum_rule_based_planner)/launch/minimum_rule_based_planner.launch.xml">
            <arg name="minimum_rule_base_planner_param_path" value="$(var minimum_rule_base_planner_param_path)"/>
            <arg name="minimum_rule_base_planner_elastic_band_smoother_param_path" value="$(var minimum_rule_base_planner_elastic_band_smoother_param_path)"/>
            <arg name="minimum_rule_base_planner_jerk_filtered_smoother_param_path" value="$(var minimum_rule_base_planner_jerk_filtered_smoother_param_path)"/>
            <arg name="input_route" value="/planning/mission_planning/route"/>
            <arg name="input_vector_map" value="/map/vector_map"/>
            <arg name="input_odometry" value="/localization/kinematic_state"/>
            <arg name="input_acceleration" value="/localization/acceleration"/>
            <arg name="input_objects" value="$(var input_objects_topic_name)"/>
            <arg name="input_pointcloud" value="$(var input_pointcloud_topic_name)"/>
            <arg name="output_candidate_trajectories" value="/planning/generator/candidate_trajectories"/>
          </include>
        </group>
      </group>
    </group>

    <!-- trajectory selector -->
    <group>
      <push-ros-namespace namespace="trajectory_selector"/>
      <include file="$(find-pkg-share autoware_trajectory_concatenator)/launch/trajectory_concatenator.launch.xml">
        <arg name="trajectory_concatenator_param_path" value="$(var trajectory_concatenator_param_path)"/>
        <arg name="concatenator_input_trajectories" value="/planning/generator/candidate_trajectories"/>
        <arg name="concatenator_output_trajectories" value="/planning/trajectory_selector/concatenated/candidate_trajectories"/>
      </include>

      <include file="$(find-pkg-share autoware_trajectory_validator)/launch/trajectory_validator.launch.xml">
        <arg name="trajectory_validator_param_path" value="$(var trajectory_validator_param_path)"/>
        <arg name="input_trajectories" value="/planning/trajectory_selector/concatenated/candidate_trajectories"/>
        <arg name="output_trajectories" value="/planning/trajectory_selector/validator/candidate_trajectories"/>
        <arg name="input_vector_map" value="/map/vector_map"/>
        <arg name="input_odometry" value="/localization/kinematic_state"/>
        <arg name="input_objects" value="$(var input_objects_topic_name)"/>
        <arg name="input_acceleration" value="/localization/acceleration"/>
        <arg name="input_traffic_signals" value="/perception/traffic_light_recognition/traffic_signals"/>
        <arg name="input_route" value="/planning/mission_planning/route"/>
      </include>

      <include file="$(find-pkg-share autoware_trajectory_ranker)/launch/simple_trajectory_ranker.launch.xml">
        <arg name="trajectory_ranker_param_path" value="$(var trajectory_ranker_param_path)"/>
        <arg name="input_trajectories" value="/planning/trajectory_selector/validator/candidate_trajectories"/>
        <arg name="output_trajectories" value="/planning/trajectory_selector/ranker/scored_trajectories"/>
      </include>
      <include file="$(find-pkg-share autoware_trajectory_adapter)/launch/trajectory_adapter.launch.xml">
        <arg name="input_trajectories" value="/planning/trajectory_selector/ranker/scored_trajectories"/>
        <arg name="output_trajectory" value="/planning/trajectory"/>
      </include>
    </group>

    <!-- hazard lights selector -->
    <group>
      <include file="$(find-pkg-share autoware_hazard_lights_selector)/launch/hazard_lights_selector.launch.xml"/>
    </group>

    <!-- planning evaluator -->
    <group>
      <include file="$(find-pkg-share autoware_planning_evaluator)/launch/planning_evaluator.launch.xml">
        <arg name="input/objects" value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/predicted_objects"/>
        <arg name="input/reference_trajectory" value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/trajectory"/>
      </include>
    </group>

    <!-- mission remaining distance and time calculator -->
    <group if="$(var launch_remaining_distance_time_calculator)">
      <include file="$(find-pkg-share autoware_remaining_distance_time_calculator)/launch/remaining_distance_time_calculator.launch.xml"/>
    </group>

    <group if="$(var launch_proximity_hazard_object_checker)">
      <include file="$(find-pkg-share autoware_proximity_hazard_object_checker)/launch/proximity_hazard_object_checker.launch.xml"/>
    </group>
  </group>
</launch>
