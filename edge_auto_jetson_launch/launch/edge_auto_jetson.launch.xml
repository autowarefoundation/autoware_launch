<!--
This launch file is the unified launch file for all edge_auto_jetson nodes.

Determined by the environment variable or command line argument, this launch file will launch
the corresponding edge_auto_jetson launch file.
-->
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" />
  <arg name="jetson_id" default="$(env JETSON_ID -1)" />
  
  <let name="ecu_name" value="jetson$(var jetson_id)" if="$(eval '&quot;$(var jetson_id)&quot;>=&quot;0&quot;')"/>
  <let name="ecu_name" value="addon" unless="$(eval '&quot;$(var jetson_id)&quot;>=&quot;0&quot;')"/>


  <arg name="live_sensor" default="True"
       description="If true, camera drivers will be booted. Otherwise, image decompressor will be launched."/>
  <arg name="perception" default="True"
       description="If true, series of perception stack will be booted."/>
  <arg name="streampetr_enabled" default="true" description="If true, StreamPETR perception will be launched." />

  <include file="$(find-pkg-share edge_auto_jetson_launch)/launch/edge_auto_jetson_$(var ecu_name).launch.xml">
    <arg name="vehicle_id" value="$(var vehicle_id)" />
    <arg name="live_sensor" value="$(var live_sensor)" />
    <arg name="perception" value="$(var perception)" />
    <arg name="streampetr_enabled" value="$(var streampetr_enabled)" />
  </include>
</launch>
