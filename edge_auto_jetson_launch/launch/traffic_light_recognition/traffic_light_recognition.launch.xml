<?xml version="1.0"?>
<launch>
  <arg name="use_high_accuracy_detection" default="true" description="enable fine position adjustment of traffic light"/>
  <arg name="high_accuracy_detection_type" default="fine_detection" description="select high accuracy detector type for traffic light recognition: fine_detection or whole_image_detection"/>

  <arg name="camera_name" default="camera7" description="camera name"/>
  <arg name="container" description="component container name"/>
  <arg name="build_engine_only" default="false" description="exit after trt engine is built"/>

  <arg name="traffic_light_fine_detector_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/traffic_light_fine_detector.param.yaml"/>
  <arg name="car_traffic_light_classifier_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/car_traffic_light_classifier.param.yaml"/>
  <arg name="pedestrian_traffic_light_classifier_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/pedestrian_traffic_light_classifier.param.yaml"/>
  <arg name="traffic_light_roi_visualizer_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/traffic_light_roi_visualizer.param.yaml"/>
  <arg name="whole_image_detector_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/yolox_traffic_light_detector.param.yaml"/>

  <let name="input/image" value="/sensing/camera/$(var camera_name)/image_raw"/>
  <let name="input/camera_info" value="/sensing/camera/$(var camera_name)/camera_info"/>
  <let name="output/rois" value="/perception/traffic_light_recognition/$(var camera_name)/detection/rois"/>
  <let name="output/traffic_signals" value="/perception/traffic_light_recognition/$(var camera_name)/classification/traffic_signals"/>
  <let name="output/car/traffic_signals" value="/perception/traffic_light_recognition/$(var camera_name)/classification/classified/car/traffic_signals"/>
  <let name="output/pedestrian/traffic_signals" value="/perception/traffic_light_recognition/$(var camera_name)/classification/classified/pedestrian/traffic_signals"/>
  <let name="map_based_detector_output_topic" value="rough/rois" if="$(var use_high_accuracy_detection)"/>
  <let name="map_based_detector_output_topic" value="$(var output/rois)" unless="$(var use_high_accuracy_detection)"/>

  <!--  Build engine file only -->
  <group if="$(var build_engine_only)">
    <node pkg="autoware_traffic_light_fine_detector" exec="traffic_light_fine_detector_node" name="traffic_light_fine_detector" output="screen">
      <param from="$(var traffic_light_fine_detector_param_path)" allow_substs="true"/>
      <param name="build_only" value="$(var build_engine_only)"/>
    </node>

    <node pkg="autoware_traffic_light_classifier" exec="traffic_light_classifier_node" name="traffic_light_classifier" output="screen">
      <param from="$(var car_traffic_light_classifier_param_path)" allow_substs="true"/>
      <param name="build_only" value="$(var build_engine_only)"/>
    </node>

    <node pkg="autoware_traffic_light_classifier" exec="traffic_light_classifier_node" name="traffic_light_classifier" output="screen">
      <param from="$(var pedestrian_traffic_light_classifier_param_path)" allow_substs="true"/>
      <param name="build_only" value="$(var build_engine_only)"/>
    </node>

    <node pkg="autoware_tensorrt_yolox" exec="autoware_tensorrt_yolox_node_exe" name="tensorrt_yolox" output="screen">
      <param from="$(var whole_image_detector_param_path)" allow_substs="true"/>
      <param name="build_only" value="$(var build_engine_only)"/>
    </node>
  </group>

  <!--  TLR pipeline -->
  <group unless="$(var build_engine_only)">
    <!-- map based detector -->
    <group>
      <push-ros-namespace namespace="perception/traffic_light_recognition/$(var camera_name)"/>
      <node pkg="topic_tools" exec="relay" name="traffic_light_camera_info_relay" args="$(var input/camera_info) camera_info"/>
      <group>
        <push-ros-namespace namespace="detection"/>
        <include file="$(find-pkg-share autoware_traffic_light_map_based_detector)/launch/traffic_light_map_based_detector.launch.xml">
          <arg name="input/camera_info" value="$(var input/camera_info)"/>
          <arg name="min_timestamp_offset" value="-0.04"/>
          <arg name="expect/rois" value="expect/rois"/>
          <arg name="output/rois" value="$(var map_based_detector_output_topic)"/>
          <arg name="output/camera_info" value="camera_info"/>
        </include>
      </group>
      <!-- fine detector and classifier -->
      <include file="$(find-pkg-share edge_auto_jetson_launch)/launch/traffic_light_recognition/traffic_light_node_container.launch.py">
        <arg name="traffic_light_fine_detector_param_path" value="$(var traffic_light_fine_detector_param_path)"/>
        <arg name="car_traffic_light_classifier_param_path" value="$(var car_traffic_light_classifier_param_path)"/>
        <arg name="pedestrian_traffic_light_classifier_param_path" value="$(var pedestrian_traffic_light_classifier_param_path)"/>
        <arg name="traffic_light_roi_visualizer_param_path" value="$(var traffic_light_roi_visualizer_param_path)"/>
        <arg name="whole_image_detector_param_path" value="$(var whole_image_detector_param_path)"/>
        <arg name="input/image" value="$(var input/image)"/>
        <arg name="input/camera_info" value="$(var input/camera_info)"/>
        <arg name="use_high_accuracy_detection" value="$(var use_high_accuracy_detection)"/>
        <arg name="high_accuracy_detection_type" value="$(var high_accuracy_detection_type)"/>
        <arg name="use_intra_process" value="true"/>
        <arg name="use_multithread" value="true"/>
        <arg name="output/rois" value="$(var output/rois)"/>
        <arg name="output/traffic_signals" value="$(var output/traffic_signals)"/>
        <arg name="output/car/traffic_signals" value="$(var output/car/traffic_signals)"/>
        <arg name="output/pedestrian/traffic_signals" value="$(var output/pedestrian/traffic_signals)"/>
        <arg name="container" value="$(var container)"/>
      </include>
    </group>
  </group>
</launch>
