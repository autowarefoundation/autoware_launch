<!--
This launch file sets up a Gen2 multi-camera perception pipeline that includes:

1. Camera Input Pipeline (configurable via live_sensor arg):
   - When live_sensor=true: Uses V4L2 camera drivers for live camera input
   - When live_sensor=false: Uses image transport decompressor for rosbag playback
   - GPU-accelerated image processing using accelerated_image_processor

2. Object Recognition Pipeline (for each camera):
   - TensorRT-optimized YOLOX object detection
   - ByteTrack object tracking

2. Traffic Light Detection Pipeline (for each camera): 
   - Map based detector
   - Fine Detector
   - Traffic Light Classifier

Key Features:
- Supports multiple cameras (configured via camera_ids arrays)
- Configurable YOLOX precision (fp32/fp16/int8)
- Optional sensor trigger node for synchronized capture
- Containerized components for efficient resource management
- Build engine only option for building TensorRT engines only
-->
<launch>
  <arg name="object_recognition_camera_ids" default="[8, 9, 10]" />
  <arg name="camera_driver_camera_ids" default="[]" />
  <arg name="traffic_light_camera_ids" default="[]" />
  <arg name="yolox_precision" default="int8" />
  <arg name="build_engine_only" default="false" />
  <arg name="use_multithread" default="true" />
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" />

  <arg name="live_sensor" default="true" description="If true, this launcher runs image_transport_decompressor instead of camera driver" />

  <arg name="container_name" default="object_recognition_container" />

  <!-- path to the yaml file that contains parameters for sensor_trigger node -->
  <arg name="launch_sensor_trigger" default="false"/>
  <let name="sensor_trigger_param_path" value="$(find-pkg-share individual_params)/config/$(var vehicle_id)/$(env SENSOR_MODEL aip_x2_gen2)/tier4-c2/camera$(var camera0_id)_trigger.param.yaml" />

  <!-- object recognition -->
  <include file="$(find-pkg-share edge_auto_jetson_launch)/launch/edge_auto_multi_launch_engine.launch.py">
    <arg name="object_recognition_camera_ids" value="$(var object_recognition_camera_ids)" />
    <arg name="traffic_light_camera_ids" value="$(var traffic_light_camera_ids)" />
    <arg name="camera_driver_camera_ids" value="$(var camera_driver_camera_ids)" />
    <arg name="live_sensor" value="$(var live_sensor)" />
    <arg name="container_name" value="$(var container_name)" />
    <arg name="yolox_precision" value="$(var yolox_precision)" />
    <arg name="build_engine_only" value="$(var build_engine_only)" />
    <arg name="use_multithread" value="$(var use_multithread)" />
  </include>

  <!-- Run a trigger node as individual process to keep time interval accuracy -->
  <group if="$(var launch_sensor_trigger)">
  <node pkg="sensor_trigger" exec="sensor_trigger_exe" name="sensor_trigger_$(env JETSON_ID)">
    <param from="$(var sensor_trigger_param_path)"/>
  </node>
  </group>
</launch>
